# Все ключи можно задать здесь ИЛИ в веб-панели (Настройки) — панель сохраняет их в data/settings.json.
# Значения из веб-панели имеют приоритет. Ключи хранятся только локально у тебя.

PORT=3000

# Какой провайдер использовать по умолчанию: openai | anthropic | gemini | openrouter | groq | deepseek | ollama | custom
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Любой OpenAI-совместимый сервер (LM Studio, vLLM, Together, свой прокси...)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

MC_HOST=localhost
MC_PORT=25565
# пусто = автоопределение версии сервера
MC_VERSION=
# offline (пиратка/локальная сеть) или microsoft (лицензионный аккаунт для бота)
MC_AUTH=offline
